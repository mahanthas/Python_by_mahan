; ******* Steps for flashing in OSPI mode************************************

;clear the macro buffer
flushrecv

;setting a timeout for wait
timeout=10

;wait for the screen prompt
wait "completing the Vipers1 process ...."

;get the activities processed on ECU
sendln "ps -A"
pause 1

;execute the perf-viewer application
sendln "echo calling the perf-viewer"
pause 1
sendln "cd /opt/bosch/prk/bin/"
pause 1
sendln "./perf-viewer -f /opt/bosch/prk/bin/measurement.csv"
pause 10
sendln "222222"
pause 30
sendln "qqqqqq"
pause 2

;disconnect COM port
disconnect 0
;close teraterm
closett
end
;************************************************************************************

:abort

; echo error cather line
sendln "echo ERROR-ABORT!!!"
pause 1
;set exit code
setexitcode 101
;disconnect COM port
disconnect 0
;close teraterm
closett
end
